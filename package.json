{
  "name": "yesnobuttonapp.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "images:convert": "node scripts/convert-images.js",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && npx wrangler pages deploy dist/ --project-name yesnobuttonapp-com --branch main",
    "deploy:preview": "astro build && npx wrangler pages deploy dist/ --project-name yesnobuttonapp-com",
    "deploy:indexnow": "npm run deploy && npm run indexnow",
    "indexnow": "node scripts/submit-indexnow.mjs"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "sharp": "^0.32.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.5",
    "tailwindcss": "^4.3.0"
  }
}
