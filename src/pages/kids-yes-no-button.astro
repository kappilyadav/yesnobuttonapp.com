---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import YesNoTool from '../components/tool/YesNoTool.astro';
import ResultPopup from '../components/tool/ResultPopup.astro';
import HistoryTracker from '../components/tool/HistoryTracker.astro';
import FAQAccordion from '../components/content/FAQAccordion.astro';
import MoreTools from '../components/content/MoreTools.astro';
// import BlogSection from '../components/content/BlogSection.astro';
import { createWebAppSchema, createFaqSchema, breadcrumbSchema } from '../data/schemas';

const faqItems = [
  { category: 'general', question: 'Is adult supervision needed for the Kids Yes No Button?', answer: 'We recommend it for younger children, the same as with any website. There is nothing to buy, no chat feature, and no account to create, but sitting with your child the first few times helps them understand it is just for fun, not a real decision-maker for anything serious.' },
  { category: 'general', question: 'Why use a random button instead of just deciding for my kid?', answer: 'Handing a small decision to chance takes the "why not them and not me" argument out of sibling disputes, since nobody chose the outcome. It also gives kids an early, low-stakes way to practice accepting an answer they did not pick.' },
  { category: 'general', question: 'Does the Kids Yes No Button track or save anything about my child?', answer: 'No. It runs entirely in the browser and does not collect names, ages, or any personal information. The only thing saved locally is a short result history, which clears when you press the clear history link.' },
  { category: 'general', question: 'What age range is this designed for?', answer: 'It works well for roughly ages 4 and up, once a child understands the difference between yes and no. Older kids and tweens tend to enjoy it as a party or sleepover game rather than a daily tool.' },

  { category: 'daily', question: 'Can siblings take turns with the same button?', answer: 'Yes. Since results are not tied to any account, kids can pass the device back and forth and each press the button for their own turn.' },
  { category: 'daily', question: 'What if my child does not like the answer they get?', answer: 'That is a good moment to talk about it. Ask how they feel about the result: a strong reaction is often a sign of what they actually wanted, and it can turn a random button press into a short conversation about their own preferences.' },
];

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Kids Yes No Button', url: '/kids-yes-no-button/' },
]);
---

<BaseLayout
  title="Kids Yes No Button  -  Family-Friendly Random Decision Tool"
  description="A kid-friendly yes no button for family games, routines, and simple choices. Bright, simple, free, and easy to use together."
  canonical="https://yesnobuttonapp.com/kids-yes-no-button/"
  schema={[createWebAppSchema({ name: "Kids Yes No Button", url: "https://yesnobuttonapp.com/kids-yes-no-button/", description: "A kid-friendly yes no button for family games, routines, and simple choices. Bright, simple, free, and easy to use together." }), createFaqSchema(faqItems), breadcrumb]}
>
  <Fragment slot="header"><Header /></Fragment>

  <section class="relative overflow-hidden bg-gradient-to-br from-[#fef9c3] via-[#fde68a] to-[#fcd34d] dark:from-[#1a3a1a] dark:via-[#2a4a2a] dark:to-[#1a3a1a]">
    <div class="absolute inset-0 opacity-10 dark:opacity-5" style="background-image: url('data:image/svg+xml;utf8,<svg width=\"60\" height=\"60\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"30\" cy=\"30\" r=\"8\" fill=\"%23f59e0b\" opacity=\"0.3\"/></svg>'); background-size: 60px 60px;"></div>

    <div class="relative py-12 md:py-20">
      <div class="container text-center">
        <p class="text-sm uppercase tracking-[0.15em] text-[#d97706] dark:text-[#fbbf24] mb-3 font-medium">&#9733; Family-friendly decision maker &#9733;</p>
        <h1 class="font-display text-3xl md:text-5xl tracking-tight text-[#92400e] dark:text-[#fde68a] mb-3">
          Kids Yes No Button
        </h1>
        <p class="text-[#b45309] dark:text-[#fcd34d]/80 text-base md:text-lg mb-10 max-w-xl mx-auto">
          A simple yes or no button for family games, routines, and everyday choices.
        </p>

        <div id="kids-tool" class="max-w-lg mx-auto">
          <div class="p-6 rounded-2xl border-2 border-[#f59e0b]/30 bg-white/60 dark:bg-[#2a4a2a]/40 backdrop-blur-sm">
            <YesNoTool />
            <ResultPopup />
            <HistoryTracker />
          </div>
        </div>
      </div>
    </div>

    <div class="relative py-section max-sm:py-12 bg-white/80 dark:bg-[#1a3a1a]/80">
      <div class="container max-w-3xl">
        <h2 class="font-display text-2xl md:text-3xl tracking-tight text-[#92400e] dark:text-[#fde68a] mb-6">
          What Is the Kids Yes No Button?
        </h2>
        <div class="text-[#78716c] dark:text-[#a8c8a8] space-y-4 leading-relaxed">
          <p>This is the family version of our <a href="/" class="underline">Yes No Button</a>, built for a different audience with different problems: whose turn it is next, which sibling gets to pick the show, whether it's really time to put the toys away. It uses the same fair, equal-odds mechanism as the main tool, just wrapped in bigger buttons, brighter colors, and simpler wording so a child can use it on their own. Grown-ups looking for a general <a href="/" class="underline">random decision maker</a> can use the standard version.</p>
          <p>What makes this useful for families specifically is that the outcome belongs to nobody. When a parent decides who goes first, there's a decider to blame. When the button decides, there isn't, and that small shift is often enough to end an argument before it starts.</p>
        </div>
      </div>
    </div>

    <div class="relative py-section max-sm:py-12 bg-[#fef9c3]/60 dark:bg-[#0f2a0f]/60">
      <div class="container max-w-3xl">
        <h2 class="font-display text-2xl md:text-3xl tracking-tight text-[#92400e] dark:text-[#fde68a] mb-6">
          Turning Everyday Choices Into a Game
        </h2>
        <div class="text-[#78716c] dark:text-[#a8c8a8] space-y-4 leading-relaxed">
          <p>Kids are more likely to accept an outcome, even a chore, when it feels like a game rather than an order. Instead of announcing "you're doing the dishes tonight," assign one child to Yes and the other to No, press the button together, and let the result decide. The chore itself hasn't changed, but the framing has, and for most kids that's the difference between resistance and a shrug.</p>
          <p>This works especially well for the choices that don't actually matter enough to argue about: which cereal to eat, whether to walk or take the scooter to the park, who picks the radio station in the car. Save your own judgment for the decisions that do matter, and let the button take the small ones off your plate too.</p>
        </div>
      </div>
    </div>

    <div class="relative py-section max-sm:py-12 bg-white/80 dark:bg-[#1a3a1a]/80">
      <div class="container max-w-3xl">
        <h2 class="font-display text-2xl md:text-3xl tracking-tight text-[#92400e] dark:text-[#fde68a] mb-6">
          How to Play a Yes/No Game
        </h2>
        <ol class="list-decimal list-inside space-y-4 text-[#78716c] dark:text-[#a8c8a8] leading-relaxed">
          <li><strong class="text-[#92400e] dark:text-[#fde68a]">Gather your players</strong>  -  two or more people. One person asks questions, the others answer.</li>
          <li><strong class="text-[#92400e] dark:text-[#fde68a]">Set the rule</strong>  -  answers must be ONLY &quot;Yes&quot; or &quot;No.&quot; No nodding, shaking your head, or saying anything else!</li>
          <li><strong class="text-[#92400e] dark:text-[#fde68a]">Use the button</strong>  -  click the Kids Yes No Button to get a random yes or no prompt. Use it as inspiration for questions.</li>
          <li><strong class="text-[#92400e] dark:text-[#fde68a]">Take turns</strong>  -  ask silly, serious, or surprising questions. The fun is in keeping a straight face.</li>
          <li><strong class="text-[#92400e] dark:text-[#fde68a]">Last one standing wins</strong>  -  anyone who says a word other than yes or no is out!</li>
        </ol>
      </div>
    </div>

    <div class="relative py-section max-sm:py-12 bg-[#fef9c3]/60 dark:bg-[#0f2a0f]/60">
      <div class="container max-w-3xl">
        <h2 class="font-display text-2xl md:text-3xl tracking-tight text-[#92400e] dark:text-[#fde68a] mb-6">
          Fun Questions to Ask
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div class="p-4 rounded-xl bg-[#fef9c3] dark:bg-[#2a4a2a] text-[#92400e] dark:text-[#fde68a] text-sm font-medium">&quot;Do you like broccoli?&quot;</div>
          <div class="p-4 rounded-xl bg-[#fef9c3] dark:bg-[#2a4a2a] text-[#92400e] dark:text-[#fde68a] text-sm font-medium">&quot;Is a hot dog a sandwich?&quot;</div>
          <div class="p-4 rounded-xl bg-[#fef9c3] dark:bg-[#2a4a2a] text-[#92400e] dark:text-[#fde68a] text-sm font-medium">&quot;Should we go to the park?&quot;</div>
          <div class="p-4 rounded-xl bg-[#fef9c3] dark:bg-[#2a4a2a] text-[#92400e] dark:text-[#fde68a] text-sm font-medium">&quot;Do you think cats are better than dogs?&quot;</div>
          <div class="p-4 rounded-xl bg-[#fef9c3] dark:bg-[#2a4a2a] text-[#92400e] dark:text-[#fde68a] text-sm font-medium">&quot;Is it time for a dance party?&quot;</div>
          <div class="p-4 rounded-xl bg-[#fef9c3] dark:bg-[#2a4a2a] text-[#92400e] dark:text-[#fde68a] text-sm font-medium">&quot;Should we build a pillow fort?&quot;</div>
        </div>
      </div>
    </div>

    <div class="relative py-section max-sm:py-12 bg-white/80 dark:bg-[#1a3a1a]/80">
      <div class="container max-w-3xl">
        <h2 class="font-display text-2xl md:text-3xl tracking-tight text-[#92400e] dark:text-[#fde68a] mb-6">
          Frequently Asked Questions
        </h2>
        <FAQAccordion items={faqItems} />
      </div>
    </div>
  </section>

  <!-- <BlogSection /> -->

  <MoreTools />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<script>
  import { initTool } from '../scripts/tool';
  initTool();
</script>
