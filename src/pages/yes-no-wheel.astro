---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WheelControls from '../components/tool/WheelControls.astro';
import WheelSpinner from '../components/tool/WheelSpinner.astro';
import ResultPopup from '../components/tool/ResultPopup.astro';
import HistoryTracker from '../components/tool/HistoryTracker.astro';
import FAQAccordion from '../components/content/FAQAccordion.astro';
import MoreTools from '../components/content/MoreTools.astro';
// import BlogSection from '../components/content/BlogSection.astro';
import { createWebAppSchema, createFaqSchema, breadcrumbSchema } from '../data/schemas';

const faqItems = [
  { category: 'general', question: 'How is a spinner wheel different from a raffle or prize wheel?', answer: 'Prize wheels and raffle wheels usually have unequal segments: some prizes are rarer than others by design. This yes no wheel always splits the wheel into two exactly equal halves, so the odds never favor one outcome over the other.' },
  { category: 'general', question: 'Can I use this instead of a printed decision wheel for the classroom?', answer: 'Yes. Teachers often use printable decision wheels for picking students or activities. This digital version needs no printing, laminating, or a physical spinner arm, and it resets instantly for the next spin.' },
  { category: 'general', question: 'Why does the wheel animation matter if the result is already decided by Math.random()?', answer: 'It doesn’t change the odds, but it changes how the result feels. A brief spin gives everyone in the room a shared moment of suspense before the answer lands, the same reason physical spinner games use motion instead of an instant readout.' },
  { category: 'general', question: 'Is a digital wheel more reliable than a physical one?', answer: 'A physical spinner can be biased by wear, an uneven surface, or how hard someone flicks it. This wheel has no moving parts to wear down, so the probability stays exactly 50/50 spin after spin.' },
  { category: 'general', question: 'Can groups take turns spinning the same wheel?', answer: 'Yes. Since nothing is saved to a server, anyone can hand the device to the next person and spin again with no setup between turns.' },
];

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Yes No Wheel', url: '/yes-no-wheel/' },
]);
---

<BaseLayout
  title="Yes No Wheel — Spin a Random Yes or No Wheel Online"
  description="Free yes no wheel spinner. Get a random yes or no result with one click: faster than spinning a real wheel."
  canonical="https://yesnobuttonapp.com/yes-no-wheel/"
  schema={[createWebAppSchema({ name: "Yes No Wheel", url: "https://yesnobuttonapp.com/yes-no-wheel/", description: "Free yes no wheel spinner. Get a random yes or no result with one click: faster than spinning a real wheel." }), createFaqSchema(faqItems), breadcrumb]}
>
  <Fragment slot="header"><Header /></Fragment>

  <!-- HERO -->
  <section class="bg-canvas dark:bg-canvas-dark py-[60px] max-sm:py-[40px]">
    <div class="container">
      <div class="text-center mb-10 max-sm:mb-6">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-ink dark:text-ink-dark leading-tight mb-3">
          Yes No Wheel
        </h1>
        <p class="text-muted dark:text-muted-dark leading-relaxed max-w-xl mx-auto">
          Spin the wheel for a random yes or no decision. No physical spinner needed.
        </p>
      </div>

      <!-- Two-column layout -->
      <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-8 max-sm:gap-6 items-start max-w-4xl mx-auto">
        <!-- Wheel (first on mobile, right on desktop) -->
        <div class="flex flex-col items-center gap-5 lg:order-2">
          <WheelSpinner />
        </div>

        <!-- Controls (second on mobile, left on desktop) -->
        <div class="lg:order-1">
          <WheelControls />
        </div>
      </div>

      <!-- Question input -->
      <div class="max-w-2xl mx-auto mt-10 max-sm:mt-6">
        <input
          id="question-input"
          type="text"
          placeholder="Type your question here (optional)"
          class="w-full px-6 py-4 rounded-2xl border border-border dark:border-border-dark bg-card dark:bg-card-dark text-ink dark:text-ink-dark text-sm placeholder:text-muted dark:placeholder:text-muted-dark focus:outline-hidden focus:ring-2 focus:ring-[#8B5CF6]/20 dark:focus:ring-[#A78BFA]/20 transition-all"
        />
      </div>

      <!-- History -->
      <div class="max-w-lg mx-auto mt-6">
        <HistoryTracker />
      </div>

      <ResultPopup />
    </div>
  </section>

  <!-- SECTION 1: What Is a Yes No Wheel? -->
  <section class="bg-card dark:bg-card-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-4">
        What Is a Yes No Wheel?
      </h2>
      <div class="text-muted dark:text-muted-dark leading-relaxed space-y-4">
        <p>Spinner wheels have been used for picking winners, dares, and decisions for generations, from carnival prize wheels to the wheel on a classic game show to a laminated chart taped to a classroom whiteboard. This tool takes that familiar spin-and-land format and narrows it to exactly two equal outcomes: Yes or No.</p>
        <p>Unlike a button press, a spin has a beginning, a middle, and an end. That short window of motion is the whole reason people reach for a wheel instead of a coin or a click: it turns a decision into a small shared moment, which is why decision wheels show up so often in classrooms, group games, and livestreams where an audience is watching the outcome unfold together. If you just want a fast answer, the <a href="/" class="text-ink dark:text-ink-dark underline hover:no-underline">yes or no button</a> skips the spin.</p>
      </div>
      <p class="text-sm text-muted dark:text-muted-dark mt-4">
        Curious about the exact math behind the spin? See <a href="/#how-it-works" class="text-ink dark:text-ink-dark underline hover:no-underline">how the random result is generated</a> on the main Yes No Button page.
      </p>
    </div>
  </section>

  <!-- SECTION 1B: Best Uses for a Yes No Wheel -->
  <section class="bg-canvas dark:bg-canvas-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-5">
        Best Uses for a Yes No Wheel
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-card dark:bg-card-dark border border-border dark:border-border-dark rounded-2xl p-5">
          <h3 class="font-medium text-[15px] text-ink dark:text-ink-dark mb-1.5">Classroom picks</h3>
          <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">Project the wheel on a screen to decide things like whether a quiz is open-book, or to add a moment of suspense before revealing which team goes first.</p>
        </div>
        <div class="bg-card dark:bg-card-dark border border-border dark:border-border-dark rounded-2xl p-5">
          <h3 class="font-medium text-[15px] text-ink dark:text-ink-dark mb-1.5">Livestreams and group calls</h3>
          <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">A spin gives viewers something to watch happen in real time, unlike an instant result, which makes it a better fit for on-screen decision moments.</p>
        </div>
        <div class="bg-card dark:bg-card-dark border border-border dark:border-border-dark rounded-2xl p-5">
          <h3 class="font-medium text-[15px] text-ink dark:text-ink-dark mb-1.5">Chore and turn rotations</h3>
          <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">Spin to decide who does the dishes tonight or whether it's someone's turn to pick the takeout order, without the wheel ever needing to be rebuilt or replaced like a paper one.</p>
        </div>
        <div class="bg-card dark:bg-card-dark border border-border dark:border-border-dark rounded-2xl p-5">
          <h3 class="font-medium text-[15px] text-ink dark:text-ink-dark mb-1.5">Warm-up for bigger games</h3>
          <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">Use a few quick spins to loosen up a group before moving into a longer game like trivia or would-you-rather.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: Yes No Wheel vs Physical Spinner -->
  <section class="bg-canvas dark:bg-canvas-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-5">
        Yes No Wheel vs Physical Spinner
      </h2>
      <div class="overflow-x-auto mb-4">
        <table class="ynb-table text-sm">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Yes No Wheel</th>
              <th>Physical Spinner</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="font-medium text-ink dark:text-ink-dark">Speed</td><td>Instant</td><td>3–5 seconds</td></tr>
            <tr><td class="font-medium text-ink dark:text-ink-dark">Device needed</td><td>Any phone or computer</td><td>Physical wheel</td></tr>
            <tr><td class="font-medium text-ink dark:text-ink-dark">Probability</td><td>Exactly 50/50</td><td>Approximately 50/50</td></tr>
            <tr><td class="font-medium text-ink dark:text-ink-dark">Voice result</td><td class="text-yes">&#x2713; Yes</td><td class="text-no dark:text-no-dark">&#x2717; No</td></tr>
            <tr><td class="font-medium text-ink dark:text-ink-dark">Shareable result</td><td class="text-yes">&#x2713; Yes</td><td class="text-no dark:text-no-dark">&#x2717; No</td></tr>
            <tr><td class="font-medium text-ink dark:text-ink-dark">Available 24/7</td><td class="text-yes">&#x2713; Yes</td><td class="text-no dark:text-no-dark">&#x2717; No</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-muted dark:text-muted-dark leading-relaxed">
        The digital yes no wheel has one significant advantage over its physical counterpart: it cannot be influenced by spin speed, angle, or technique. Every digital "spin" is a pure mathematical random event.
      </p>
    </div>
  </section>

  <!-- SECTION 3: How to Use This Yes No Wheel -->
  <section class="bg-card dark:bg-card-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-5">
        How to Use This Yes No Wheel
      </h2>
      <ol class="list-decimal list-inside text-muted dark:text-muted-dark space-y-3 leading-relaxed">
        <li>Type your question (optional).</li>
        <li>Click the button: the wheel "spins" and lands on Yes or No.</li>
        <li>The result appears with a spin animation and is read aloud.</li>
        <li>Click again to spin again for a new independent result.</li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-canvas dark:bg-canvas-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-6">
        Frequently Asked Questions
      </h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <!-- <BlogSection /> -->

  <MoreTools />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<script>
  import { initWheel } from '../scripts/wheel';
  initWheel();
</script>
