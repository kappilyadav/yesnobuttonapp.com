---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import YesNoTool from '../components/tool/YesNoTool.astro';
import ResultPopup from '../components/tool/ResultPopup.astro';
import HistoryTracker from '../components/tool/HistoryTracker.astro';
import CategoryTabs from '../components/tool/CategoryTabs.astro';
import EmbedWidget from '../components/tool/EmbedWidget.astro';
import FAQAccordion from '../components/content/FAQAccordion.astro';
import SeasonalTable from '../components/content/SeasonalTable.astro';
// import BlogSection from '../components/content/BlogSection.astro';
import { webAppSchema, createFaqSchema, breadcrumbSchema } from '../data/schemas';
import '@fontsource/baloo-2/700.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/caveat/700.css';
import baloo700Woff2 from '@fontsource/baloo-2/files/baloo-2-latin-700-normal.woff2?url';
import baloo800Woff2 from '@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2?url';
import caveat700Woff2 from '@fontsource/caveat/files/caveat-latin-700-normal.woff2?url';

const seasonalQuestions = [
  { question: 'Should I go to the beach this weekend?', reason: 'Summer is here and the warm weather makes beach trips the perfect spontaneous decision.' },
  { question: 'Should I start a summer reading list?', reason: 'June is a great time to pick up new books with long sunny days ahead.' },
  { question: 'Should I plan a summer road trip?', reason: 'The start of summer is the ideal time to decide on travel plans before schedules fill up.' },
  { question: 'Should I try outdoor yoga?', reason: 'Warm mornings make outdoor exercise inviting and refreshing.' },
  { question: 'Should I host a barbecue?', reason: 'June evenings are perfect for gathering friends for an outdoor meal.' },
  { question: 'Should I take a staycation?', reason: 'Sometimes the best summer break is right at home with no travel stress.' },
];

const julyQuestions = [
  { question: 'Should I go to the beach this weekend?', reason: 'Perfect for summer decision paralysis' },
  { question: 'Is it too hot to cook: should I order out?', reason: 'The eternal July dilemma' },
  { question: 'Should I take a vacation in July?', reason: 'Peak summer planning anxiety' },
  { question: 'Should I start that summer project I\'ve been putting off?', reason: 'July accountability' },
  { question: 'Is it too early to think about back-to-school shopping?', reason: 'Parents\' July worry' },
  { question: 'Should I spend the day outdoors today?', reason: 'Weather-dependent decision' },
];

const homeBreadcrumb = breadcrumbSchema([
  { name: 'Home', url: '/' },
]);

const faqItems = [
  { category: 'general', question: 'What is a Yes No Button?', answer: 'A Yes No Button is a free online tool that randomly generates a Yes or No answer to any question. It works like flipping a coin with a 50/50 chance of either outcome, but is instantly accessible on any device without needing a physical coin.' },
  { category: 'general', question: 'Is the Yes No Button truly random?', answer: 'Yes. The Yes No Button uses JavaScript\'s Math.random() function, which generates a pseudorandom number between 0 and 1. Numbers below 0.5 produce a No; numbers at or above 0.5 produce a Yes. Each result is fully independent of previous results.' },
  { category: 'general', question: 'How does the Yes No Button decide the answer?', answer: 'When you click the button, JavaScript generates a random decimal between 0 and 1. If the number is below 0.5 the answer is No, if it is 0.5 or above the answer is Yes. In Maybe mode the range is split into three equal thirds.' },
  { category: 'general', question: 'Can I use the Yes No Button for free?', answer: 'Yes, the Yes No Button is completely free to use. There are no subscriptions, no hidden fees, and no sign-up required. It works on any device with a web browser.' },
  { category: 'general', question: 'Does the Yes No Button work on mobile?', answer: 'Yes, the Yes No Button works on all devices including smartphones, tablets, laptops, and desktop computers. The interface is fully responsive and adapts to any screen size.' },
  { category: 'general', question: 'Is there a Yes No Maybe Button?', answer: 'Yes. Use the toggle at the top of the tool to switch between Yes/No mode and Yes/No/Maybe mode. In three-way mode each outcome has an equal 33% probability.' },
  { category: 'general', question: 'Can I share my Yes No Button result?', answer: 'Yes. After each result a Share button appears. You can copy a shareable link containing your result and question, or use the native share dialog on mobile devices via the Web Share API.' },
  { category: 'general', question: 'How do I embed the Yes No Button on my website?', answer: 'Scroll to the embed section at the bottom of the page, copy the provided iframe code, and paste it into your website\'s HTML. The embed loads a lightweight version of the tool that works in any webpage.' },
  { category: 'general', question: 'Does the Yes No Button record my questions?', answer: 'No. The Yes No Button runs entirely in your browser. No questions or results are sent to any server, recorded, or stored anywhere except your browser\'s localStorage for the history feature.' },
  { category: 'general', question: 'What is the Yes No Oracle?', answer: 'The Yes No Oracle is a mystical framing of the same random yes or no tool. Instead of clicking a button, you "consult the oracle": but the underlying mechanism is identical: a truly random 50/50 result generated by JavaScript. The oracle framing appeals to users who enjoy fortune-telling, tarot, or mystical decision-making contexts. You can try the full oracle experience at <a href="/yes-no-oracle/">yesnobuttonapp.com/yes-no-oracle/</a>.' },
  { category: 'general', question: 'What is the difference between a Yes No Button and flipping a coin?', answer: 'Both produce a 50/50 random outcome, but the Yes No Button is instant, works on any device, optionally reads the answer aloud, tracks your history, and lets you share results. No physical coin needed.' },
  { category: 'general', question: 'How many times can I press the Yes No Button?', answer: 'There is no limit. You can press the button as many times as you want. Each press generates a new independent random result based on pure probability.' },
  { category: 'general', question: 'What is the probability of getting Yes vs No?', answer: 'In standard mode the probability is exactly 50/50  -  equal chance of Yes or No. In Maybe mode each of the three outcomes has a 33.3% chance.' },
  { category: 'general', question: 'Can I type my question before pressing the button?', answer: 'Yes. There is an optional text input above the button where you can type your question. If filled in, the question appears inside the result popup above the answer. The input is completely optional.' },
  { category: 'general', question: 'Is the Yes No Button available in other languages?', answer: 'Currently the Yes No Button is available in English. Multi-language support for Spanish, French, and other languages is coming soon.' },
  { category: 'general', question: 'How do I reset my Yes No Button history?', answer: 'Click the Clear history link below the result pills in the history tracker section. This removes all stored results from your browser\'s localStorage.' },
  { category: 'general', question: 'What is the Kids Yes No Button?', answer: 'The Kids Yes No Button is a family-friendly version of the tool for simple games, routines, and playful everyday decisions. It features bright colors and simple questions families can ask together.' },
  { category: 'general', question: 'Can I use the Yes No Button offline?', answer: 'Once the page has loaded, the Yes No Button runs entirely in your browser using JavaScript. If you have already visited the page, it may work offline depending on your browser\'s caching.' },

  { category: 'love', question: 'Can the Yes No Button help with relationship decisions?', answer: 'Yes. Many people use the button to break deadlocks in relationship decisions  -  whether to text someone, ask someone out, or have an important conversation. The random result can help reveal your true feelings based on how you react to the answer.' },
  { category: 'love', question: 'Should I use the Yes No Button for dating advice?', answer: 'The Yes No Button is a fun tool for lighthearted dating decisions, like picking a restaurant or deciding who chooses the movie. For serious relationship matters, it is best used as a conversation starter rather than a final authority.' },
  { category: 'love', question: 'How can couples use the Yes No Button together?', answer: 'Couples can use it to settle minor disagreements like what to watch, where to eat, or who does the dishes. It adds an element of fun and removes tension from small decisions by making chance the neutral decider.' },

  { category: 'career', question: 'Is the Yes No Button useful for career decisions?', answer: 'The button can help with career choices like whether to apply for a job, ask for a raise, or start a new project. While not a substitute for careful deliberation, the random answer can reveal your gut feeling about a decision.' },
  { category: 'career', question: 'Can I use the Yes No Button to decide whether to quit my job?', answer: 'The button can be a helpful prompt for self-reflection. If it says Yes to quitting and you feel relief, that tells you something. If it says No and you feel relieved, that is also revealing. Use it as a mirror for your feelings, not as the final word.' },
  { category: 'career', question: 'How do professionals use the Yes No Button?', answer: 'Professionals use the button for low-stakes work decisions  -  which task to prioritize, whether to speak up in a meeting, or to break ties when two options seem equally good. It is a productivity tool for overcoming analysis paralysis.' },

  { category: 'food', question: 'Can I use the Yes No Button for food decisions?', answer: 'Absolutely. The button is perfect for settling the classic "what should I eat?" dilemma. Use it to decide between two restaurants, whether to cook or order in, or if you should try a new recipe.' },
  { category: 'food', question: 'Is the Yes No Button helpful for diet and lifestyle choices?', answer: 'The button can support lifestyle decisions like whether to go to the gym, try a new workout, or stick to your meal plan. It works best as a motivational prompt  -  the act of asking can strengthen your commitment.' },
  { category: 'food', question: 'Should I use the Yes No Button to decide what to cook?', answer: 'Yes. When you have two meal options and cannot decide, assign each to Yes or No and press the button. The result picks for you, turning a time-consuming choice into an instant decision.' },

  { category: 'travel', question: 'Can I use the Yes No Button for travel planning?', answer: 'Yes. Use the button to decide between destinations, whether to book a trip, or to break ties on travel logistics. It is a great way to add spontaneity to your travel decisions.' },
  { category: 'travel', question: 'Should I let the Yes No Button choose my next destination?', answer: 'For fun, you can assign two destinations to Yes and No and let the button pick. It is a playful way to discover where your travel instincts actually want to go based on your reaction to the result.' },
  { category: 'travel', question: 'How can I use the Yes No Button during trips?', answer: 'Use it on the go for small travel decisions  -  should I take the scenic route, try that local restaurant, or extend my stay. It removes friction from minor choices while travelling.' },

  { category: 'games', question: 'Can I use the Yes No Button for games?', answer: 'Yes. The Yes No Button works great as a game randomizer for truth-or-dare, would-you-rather, board game decisions, picking who goes first, and many other party games.' },
  { category: 'games', question: 'Is the Yes No Button good for party games?', answer: 'The button adds an element of chance to any party game. Use it to decide dares, determine teams, or settle disputes. The fullscreen result popup makes it visible and exciting for groups.' },
  { category: 'games', question: 'How does the Yes No Button work for truth or dare?', answer: 'When a player is stuck choosing between truth and dare, assign each to Yes and No. The button picks randomly, adding unpredictability and fun to the game.' },
  { category: 'games', question: 'Can I use this for the Yes No No game?', answer: 'Yes! The "yes no no" challenge is a game where players answer rapid-fire questions without saying &quot;yes&quot; or &quot;no&quot;. Use the Yes No Button as an impartial judge: press it to randomly decide who goes first, assign penalties, or generate random questions. Toggle to Yes/No/Maybe mode for a three-way variant.' },

  { category: 'daily', question: 'Can I use the Yes No Button as a decision-making tool?', answer: 'Yes. The Yes No Button is designed as a decision-making aid. When you are stuck between two options, pressing the button can help reveal your true preference based on your emotional reaction to the result.' },
  { category: 'daily', question: 'How do I use the Yes No Button for icebreakers?', answer: 'Use the button to randomly assign group activities, break ties in team votes, or add an element of chance to group decisions. It works well as a neutral third party in group settings.' },
  { category: 'daily', question: 'Can the Yes No Button help with everyday decisions?', answer: 'Yes. Use it for low-stakes daily choices like which task to do first, whether to take a break, or what to wear. By outsourcing small decisions to the button, you save mental energy for more important things.' },
];
---

<BaseLayout
  title="Yes No Button — Free Yes or No Generator & Random Decision Maker"
  description="Free yes or no generator and random decision maker. Press the button for a random yes or no answer instantly. Also works as a yes no oracle, yes no picker, and yes no maybe tool. No sign-up needed."
  canonical="https://yesnobuttonapp.com/"
  schema={[webAppSchema, createFaqSchema(faqItems), homeBreadcrumb]}
>
  <Fragment slot="head">
    <link rel="preload" href={baloo700Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={baloo800Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={caveat700Woff2} as="font" type="font/woff2" crossorigin />
  </Fragment>

  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- Section 1: Hero / Tool -->
  <section class="py-[80px] max-sm:py-[48px] hero-gradient relative overflow-hidden">
    <!-- Decorative game-like glow behind the tool -->
    <div aria-hidden="true" class="hero-glow absolute inset-0 pointer-events-none select-none">
      <div class="animate-hero-glow absolute top-1/2 left-1/2 w-[700px] h-[700px] max-sm:w-[400px] max-sm:h-[400px] rounded-full bg-gradient-to-br from-[#16A34A]/8 via-[#7C3AED]/5 to-transparent dark:from-[#22C55E]/10 dark:via-[#A78BFA]/8 dark:to-transparent blur-3xl"></div>
      <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-[#FAFAF8]/80 to-transparent dark:from-[#111110]/80 dark:to-transparent"></div>
    </div>
    <div class="container text-center relative z-10">
      <YesNoTool toyStyle />
    </div>
  </section>

  <!-- Section 1B: Heading / Controls -->
  <section class="pt-[2px] pb-[80px] max-sm:pt-[32px] max-sm:pb-[48px] bg-[#F0FDF4] dark:bg-[#1A0A2E] relative overflow-hidden">
    <div class="container text-center relative z-10">
      <!-- Mode toggle -->
      <div
        id="mode-toggle"
        class="flex items-center gap-1 p-1 rounded-xl bg-[#F4F2EC] dark:bg-[#2A2A28] w-fit mx-auto mb-6"
        role="radiogroup"
        aria-label="Select answer mode"
      >
        <button
          data-ynb-mode="binary"
          class="px-4 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[#6B6965] dark:text-muted-dark"
          role="radio"
          aria-checked="true"
        >
          Yes / No
        </button>
        <button
          data-ynb-mode="three-way"
          class="px-4 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[#6B6965] dark:text-muted-dark"
          role="radio"
          aria-checked="false"
        >
          Yes / No / Maybe
        </button>
      </div>

      <h1 class="font-display text-4xl md:text-6xl tracking-tight text-ink dark:text-ink-dark mb-3">
        Yes No Button
      </h1>
      <p class="text-muted dark:text-muted-dark text-base md:text-lg mb-2 max-w-xl mx-auto">
        The free random yes or no decision maker. One click. Truly 50/50.
      </p>

      <ResultPopup />
    </div>
  </section>

  <!-- Section 2: What Is [bg: #FFFFFF] -->
  <section class="py-[80px] max-sm:py-[48px] bg-white dark:bg-card-dark">
    <div class="container max-w-3xl">
      <span class="block text-xs font-medium tracking-[0.1em] text-[#16A34A] uppercase mb-2.5">WHAT IS IT</span>
      <h2 class="font-display text-[36px] max-sm:text-[28px] font-bold text-[#1A1A18] dark:text-ink-dark leading-[1.15] mb-2">
        What Is the Yes No Button?
      </h2>
      <div class="text-muted dark:text-muted-dark space-y-4 leading-relaxed mt-6">
        <p>The Yes No Button is a free online random decision-making tool. It works by generating a truly random Yes or No answer with exact 50/50 probability  -  the same odds as flipping a fair coin, but instantly accessible on any device with a web browser.</p>
        <p>You can type an optional question into the input field for context, or simply hold a question in your mind and press the button. The answer appears as a fullscreen popup: a green background for Yes, a red background for No. The tool also reads the answer aloud using your device's voice synthesis, so you get both visual and audio confirmation.</p>
        <p>There is no sign-up required, no cost, and no data collection. The entire tool runs in your browser  -  nothing is sent to any server. It works on phones, tablets, laptops, and desktop computers. Whether you need a quick decision, a game randomizer, or just a moment of clarity, the Yes No Button is always ready.</p>
      </div>

      <img
        src="/images/yes-result-screenshot.webp"
        alt="Yes No Button showing a YES result in green"
        width="600"
        height="400"
        loading="lazy"
        style="border-radius: 16px; border: 1px solid #E4E2DC; width: 100%; max-width: 560px; height: auto; aspect-ratio: 600 / 400; display: block; margin: 24px auto;"
      />

      <h3 class="font-display text-lg md:text-xl tracking-tight text-ink dark:text-ink-dark mt-10 mb-6">
        Common questions people ask
      </h3>
      <div id="common-questions-list">
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I text them first?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Overthinking a message they already want to send</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I quit my job?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">A gut check for a decision they're already leaning toward</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I order pizza tonight?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Settling a classic internal debate</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I take the trip?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Getting permission from a random source to do something fun</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I go to bed now?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">The eternal battle with a good show</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-none max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I call them back?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Waiting for the right moment that never comes</span>
        </div>
      </div>
      <div class="mt-6">
        <a href="#decide-btn" class="inline-block px-6 py-3 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium hover:bg-[#27272A] dark:hover:bg-[#D4D2CC] transition-colors no-underline cursor-pointer">
          Ask the Button
        </a>
      </div>
    </div>
  </section>

  <!-- Section 3: How to Use [bg: #FAFAF8] -->
  <section class="py-[80px] max-sm:py-[48px] bg-[#FAFAF8] dark:bg-canvas-dark">
    <div class="container max-w-3xl">
      <span class="block text-xs font-medium tracking-[0.1em] text-[#16A34A] uppercase mb-2.5">HOW TO USE</span>
      <h2 class="font-display text-[36px] max-sm:text-[28px] font-bold text-[#1A1A18] dark:text-ink-dark leading-[1.15] mb-2">
        How to Use the Yes No Button
      </h2>
      <div class="text-muted dark:text-muted-dark leading-relaxed mt-4 mb-8">
        <p>Using the Yes No Button takes just seconds. Follow these eight simple steps to get the most out of the tool:</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl p-6 flex gap-4 items-start">
          <div class="flex items-center gap-3 shrink-0">
            <span class="w-9 h-9 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium flex items-center justify-center shrink-0">1</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B6965" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8a3.5 3 0 0 1 3.5 -3h1a3.5 3 0 0 1 3.5 3a3 3 0 0 1 -2 3a3 4 0 0 0 -2 4"/><path d="M12 19l0 .01"/></svg>
          </div>
          <div>
            <p class="font-medium text-[15px] text-[#1A1A18] dark:text-ink-dark">Type your question</p>
            <p class="text-[14px] text-[#6B6965] dark:text-muted-dark leading-relaxed mt-0.5">Type your question in the input field (optional but adds context)</p>
          </div>
        </div>
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl p-6 flex gap-4 items-start">
          <div class="flex items-center gap-3 shrink-0">
            <span class="w-9 h-9 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium flex items-center justify-center shrink-0">2</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B6965" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3m0 4a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-4a4 4 0 0 1 -4 -4z"/><path d="M12 7l0 4"/></svg>
          </div>
          <div>
            <p class="font-medium text-[15px] text-[#1A1A18] dark:text-ink-dark">Click the button</p>
            <p class="text-[14px] text-[#6B6965] dark:text-muted-dark leading-relaxed mt-0.5">Click the <strong class="text-ink dark:text-ink-dark">Press to Decide</strong> button</p>
          </div>
        </div>
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl p-6 flex gap-4 items-start">
          <div class="flex items-center gap-3 shrink-0">
            <span class="w-9 h-9 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium flex items-center justify-center shrink-0">3</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B6965" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/></svg>
          </div>
          <div>
            <p class="font-medium text-[15px] text-[#1A1A18] dark:text-ink-dark">See the result</p>
            <p class="text-[14px] text-[#6B6965] dark:text-muted-dark leading-relaxed mt-0.5">Wait for the animated result  -  Yes (green) or No (red)</p>
          </div>
        </div>
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl p-6 flex gap-4 items-start">
          <div class="flex items-center gap-3 shrink-0">
            <span class="w-9 h-9 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium flex items-center justify-center shrink-0">4</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B6965" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 8a5 5 0 0 1 0 8"/><path d="M17.7 5a9 9 0 0 1 0 14"/><path d="M6 15h-2a1 1 0 0 1 -1 -1v-4a1 1 0 0 1 1 -1h2l3.5 -4.5a.8 .8 0 0 1 1.5 .5v14a.8 .8 0 0 1 -1.5 .5l-3.5 -4.5"/></svg>
