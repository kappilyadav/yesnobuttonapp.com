---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import YesNoTool from '../components/tool/YesNoTool.astro';
import ResultPopup from '../components/tool/ResultPopup.astro';
import HistoryTracker from '../components/tool/HistoryTracker.astro';
import CategoryTabs from '../components/tool/CategoryTabs.astro';
import EmbedWidget from '../components/tool/EmbedWidget.astro';
import FAQAccordion from '../components/content/FAQAccordion.astro';
// import BlogSection from '../components/content/BlogSection.astro';
import { webAppSchema, createFaqSchema, breadcrumbSchema } from '../data/schemas';
import '@fontsource/baloo-2/700.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/caveat/700.css';
import baloo700Woff2 from '@fontsource/baloo-2/files/baloo-2-latin-700-normal.woff2?url';
import baloo800Woff2 from '@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2?url';
import caveat700Woff2 from '@fontsource/caveat/files/caveat-latin-700-normal.woff2?url';

const homeBreadcrumb = breadcrumbSchema([
  { name: 'Home', url: '/' },
]);

const faqItems = [
  { category: 'general', question: 'What is a yes or no button?', answer: 'A yes or no button is a free online tool that gives you a random Yes or No answer when you press it. Our yes or no button online uses a true 50/50 split, so it works like a digital coin flip: instant, on any device, and with no sign-up.' },
  { category: 'general', question: 'Can I use the yes no button online without downloading anything?', answer: 'Yes. This yes no button online runs right in your browser, so there is nothing to download or install. Open the page, press the green Y or red N button, or hit Pick Random, and you get an answer in under a second.' },
  { category: 'general', question: 'What is a Yes No Button?', answer: 'A Yes No Button is a free online tool that randomly generates a Yes or No answer to any question. It works like flipping a coin with a 50/50 chance of either outcome, but is instantly accessible on any device without needing a physical coin.' },
  { category: 'general', question: 'Is the Yes No Button truly random?', answer: 'Yes. The Yes No Button uses JavaScript\'s Math.random() function to generate a random decimal between 0 and 1. Below 0.5 produces a No; 0.5 or above produces a Yes, so each press is an exact 50/50 split. In Yes/No/Maybe mode, the range splits into three equal thirds for a 33.3% chance each. Every result is fully independent of previous ones.' },
  { category: 'general', question: 'Can I use the Yes No Button for free?', answer: 'Yes, the Yes No Button is completely free to use. There are no subscriptions, no hidden fees, and no sign-up required. It works on any device with a web browser.' },
  { category: 'general', question: 'Does the Yes No Button work on mobile?', answer: 'Yes, the Yes No Button works on all devices including smartphones, tablets, laptops, and desktop computers. The interface is fully responsive and adapts to any screen size.' },
  { category: 'general', question: 'Is there a Yes No Maybe Button?', answer: 'Yes. Use the toggle above the button to switch between Yes/No mode and Yes/No/Maybe mode. In three-way mode a purple M button appears and each outcome has an equal 33% probability.' },
  { category: 'general', question: 'What is the difference between a yes/no button and a yes and no button?', answer: 'Nothing. People search for the yes/no button, the yes and no button, the yes or no button, yes or no buttons, and plain yes no buttons, but they all mean the same thing: a button that randomly answers Yes or No. This page is all of them in one tool.' },
  { category: 'general', question: 'Can I share my Yes No Button result?', answer: 'Yes. After each result a Share button appears. You can copy a shareable link containing your result and question, or use the native share dialog on mobile devices via the Web Share API.' },
  { category: 'general', question: 'How do I embed the Yes No Button on my website?', answer: 'Scroll to the embed section at the bottom of the page, copy the provided iframe code, and paste it into your website\'s HTML. The embed loads a lightweight version of the tool that works in any webpage.' },
  { category: 'general', question: 'Does the Yes No Button record my questions?', answer: 'No. The Yes No Button runs entirely in your browser. No questions or results are sent to any server, recorded, or stored anywhere except your browser\'s localStorage for the history feature.' },
  { category: 'general', question: 'What is the Yes No Oracle?', answer: 'The Yes No Oracle is a mystical framing of the same random yes or no tool. Instead of clicking a button, you "consult the oracle": but the underlying mechanism is identical: a truly random 50/50 result generated by JavaScript. The oracle framing appeals to users who enjoy fortune-telling, tarot, or mystical decision-making contexts. You can try the full oracle experience at <a href="/yes-no-oracle/">yes or no oracle</a>.' },
  { category: 'general', question: 'What is the difference between a Yes No Button and flipping a coin?', answer: 'Both produce a 50/50 random outcome, but the Yes No Button is instant, works on any device, optionally reads the answer aloud, tracks your history, and lets you share results. No physical coin needed.' },
  { category: 'general', question: 'What is the Kids Yes No Button?', answer: 'The Kids Yes No Button is a family-friendly version of the tool for simple games, routines, and playful everyday decisions. It features bright colors and simple questions families can ask together.' },
  { category: 'general', question: 'Can I use this for the Yes No No game?', answer: 'Yes! The "yes no no" challenge is a game where players answer rapid-fire questions without saying &quot;yes&quot; or &quot;no&quot;. Use the Yes No Button as an impartial judge: press it to randomly decide who goes first, assign penalties, or generate random questions. Toggle to Yes/No/Maybe mode for a three-way variant.' },
];
---

<BaseLayout
  title="Yes No Button: Free Yes or No Button Online"
  description="Use the free yes or no button online. Press for an instant, truly random 50/50 answer with a spoken result. No sign-up. Try the yes no button now."
  canonical="https://yesnobuttonapp.com/"
  schema={[webAppSchema, createFaqSchema(faqItems), homeBreadcrumb]}
>
  <Fragment slot="head">
    <link rel="preload" href={baloo700Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={baloo800Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={caveat700Woff2} as="font" type="font/woff2" crossorigin />
  </Fragment>

  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- Section 1: Hero / Tool -->
  <section class="pt-[80px] pb-[16px] max-sm:py-[48px] hero-gradient relative overflow-hidden">
    <!-- Decorative game-like glow behind the tool -->
    <div aria-hidden="true" class="hero-glow absolute inset-0 pointer-events-none select-none">
      <div class="animate-hero-glow absolute top-1/2 left-1/2 w-[700px] h-[700px] max-sm:w-[400px] max-sm:h-[400px] rounded-full bg-gradient-to-br from-[#16A34A]/8 via-[#7C3AED]/5 to-transparent dark:from-[#22C55E]/10 dark:via-[#A78BFA]/8 dark:to-transparent blur-3xl"></div>
      <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-[#FAFAF8]/80 to-transparent dark:from-[#111110]/80 dark:to-transparent"></div>
    </div>
    <div class="container text-center relative z-10">
      <YesNoTool toyStyle />
    </div>
  </section>

  <!-- Section 1B: Heading / Controls -->
  <section class="pt-[2px] pb-[80px] max-sm:pt-[32px] max-sm:pb-[48px] bg-[#F0FDF4] dark:bg-[#1A0A2E] relative overflow-hidden">
    <div class="container text-center relative z-10">
      <!-- Mode toggle -->
      <div
        id="mode-toggle"
        class="flex items-center gap-1 p-1 rounded-xl bg-[#F4F2EC] dark:bg-[#2A2A28] w-fit mx-auto mb-6"
        role="radiogroup"
        aria-label="Select answer mode"
      >
        <button
          data-ynb-mode="binary"
          class="px-4 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[#6B6965] dark:text-muted-dark"
          role="radio"
          aria-checked="true"
        >
          Yes / No
        </button>
        <button
          data-ynb-mode="three-way"
          class="px-4 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[#6B6965] dark:text-muted-dark"
          role="radio"
          aria-checked="false"
        >
          Yes / No / Maybe
        </button>
      </div>

      <h1 class="font-display text-4xl md:text-6xl tracking-tight text-ink dark:text-ink-dark mb-3">
        Yes No Button
      </h1>
      <p class="text-muted dark:text-muted-dark text-base md:text-lg mb-2 max-w-xl mx-auto">
        The free yes or no button online: a random decision maker. One click. Truly 50/50.
      </p>

      <ResultPopup />
      <HistoryTracker />
    </div>
  </section>

  <!-- Section 2: What Is [bg: #FFFFFF] -->
  <section class="py-[80px] max-sm:py-[48px] bg-white dark:bg-card-dark">
    <div class="container max-w-3xl">
      <span class="block text-xs font-medium tracking-[0.1em] text-[#16A34A] uppercase mb-2.5">WHAT IS IT</span>
      <h2 class="font-display text-[36px] max-sm:text-[28px] font-bold text-[#1A1A18] dark:text-ink-dark leading-[1.15] mb-2">
        What Is the Yes No Button?
      </h2>
      <div class="text-muted dark:text-muted-dark space-y-4 leading-relaxed mt-6">
        <p>The Yes No Button is a free online random decision-making tool, a yes or no button you can use right in your browser. It works by generating a truly random Yes or No answer with exact 50/50 probability  -  the same odds as flipping a fair coin, but instantly accessible on any device with a web browser.</p>
        <p>You can type an optional question into the input field for context, or simply hold a question in your mind and press the button. The answer appears as a fullscreen popup: a green background for Yes, a red background for No. The tool also reads the answer aloud using your device's voice synthesis, so you get both visual and audio confirmation.</p>
        <p>There is no sign-up required, no cost, and no data collection. The entire tool runs in your browser  -  nothing is sent to any server. It works on phones, tablets, laptops, and desktop computers. Whether you need a quick decision, a game randomizer, or just a moment of clarity, this yes and no button is always ready, and it is just as easy to use as any physical yes no buttons you may have seen on a toy or game show. If you would rather watch the answer land, try the <a href="/yes-no-wheel/" class="text-[#16A34A] underline hover:no-underline">yes or no wheel</a> instead.</p>
      </div>

      <img
        src="/images/yes-result-screenshot.webp"
        alt="Yes No Button showing a YES result in green"
        width="600"
        height="400"
        loading="lazy"
        style="border-radius: 16px; border: 1px solid #E4E2DC; width: 100%; max-width: 560px; height: auto; aspect-ratio: 600 / 400; display: block; margin: 24px auto;"
      />

      <h3 class="font-display text-lg md:text-xl tracking-tight text-ink dark:text-ink-dark mt-10 mb-6">
        Common questions people ask
      </h3>
      <div id="common-questions-list">
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I text them first?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Overthinking a message they already want to send</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I quit my job?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">A gut check for a decision they're already leaning toward</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I order pizza tonight?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Settling a classic internal debate</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I take the trip?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Getting permission from a random source to do something fun</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-b border-[#E4E2DC] dark:border-border-dark max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I go to bed now?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">The eternal battle with a good show</span>
        </div>
        <div class="flex justify-between items-start py-[14px] border-none max-sm:flex-col max-sm:gap-1">
          <span class="text-[15px] font-medium text-[#1A1A18] dark:text-ink-dark max-sm:max-w-full"><span class="mr-2">💬</span>Should I call them back?</span>
          <span class="text-[14px] text-[#6B6965] dark:text-muted-dark text-right max-sm:text-left max-sm:max-w-full max-sm:text-[13px]">Waiting for the right moment that never comes</span>
        </div>
      </div>
      <div class="mt-6">
        <a href="#yes-no-tool" class="inline-block px-6 py-3 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium hover:bg-[#27272A] dark:hover:bg-[#D4D2CC] transition-colors no-underline cursor-pointer">
          Ask the Button
        </a>
      </div>
    </div>
  </section>

  <!-- Section 3: How to Use [bg: #FAFAF8] -->
  <section class="py-[80px] max-sm:py-[48px] bg-[#FAFAF8] dark:bg-canvas-dark">
    <div class="container max-w-3xl">
      <span class="block text-xs font-medium tracking-[0.1em] text-[#16A34A] uppercase mb-2.5">HOW TO USE</span>
      <h2 class="font-display text-[36px] max-sm:text-[28px] font-bold text-[#1A1A18] dark:text-ink-dark leading-[1.15] mb-2">
        How to Use the Yes No Button
      </h2>
      <div class="text-muted dark:text-muted-dark leading-relaxed mt-4 mb-8">
        <p>Here's exactly what you'll see, step by step:</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl overflow-hidden">
          <img
            src="/images/how-to-use-press-button.webp"
            alt="Pressing the green Y or red N button, or the Pick Random button, on the Yes No Button toy"
            width="1100"
            height="794"
            loading="lazy"
            style="width: 100%; height: auto; aspect-ratio: 1100 / 794; object-fit: cover; object-position: center; display: block;"
          />
          <div class="p-5">
            <p class="font-medium text-[15px] text-[#1A1A18] dark:text-ink-dark"><span class="text-[#16A34A]">1.</span> Press a button</p>
            <p class="text-[14px] text-[#6B6965] dark:text-muted-dark leading-relaxed mt-0.5">Tap the green <strong class="text-ink dark:text-ink-dark">Y</strong> for Yes or red <strong class="text-ink dark:text-ink-dark">N</strong> for No  -  or hit <strong class="text-ink dark:text-ink-dark">Pick Random</strong> and let the button choose for you.</p>
          </div>
        </div>
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl overflow-hidden">
          <img
            src="/images/how-to-use-see-answer.webp"
            alt="Fullscreen YES result popup with a Try Again button"
            width="1100"
            height="794"
            loading="lazy"
            style="width: 100%; height: auto; aspect-ratio: 1100 / 794; object-fit: cover; object-position: center; display: block;"
          />
          <div class="p-5">
            <p class="font-medium text-[15px] text-[#1A1A18] dark:text-ink-dark"><span class="text-[#16A34A]">2.</span> See and hear your answer</p>
            <p class="text-[14px] text-[#6B6965] dark:text-muted-dark leading-relaxed mt-0.5">A fullscreen reveal shows your result in green (Yes) or red (No) and reads it out loud. Tap anywhere or hit <strong class="text-ink dark:text-ink-dark">Try Again</strong> for a new answer.</p>
          </div>
        </div>
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl overflow-hidden">
          <img
            src="/images/how-to-use-maybe-mode.webp"
            alt="Yes No Maybe toy button showing the purple M button for a third option"
            width="1100"
            height="794"
            loading="lazy"
            style="width: 100%; height: auto; aspect-ratio: 1100 / 794; object-fit: cover; object-position: center; display: block;"
          />
          <div class="p-5">
            <p class="font-medium text-[15px] text-[#1A1A18] dark:text-ink-dark"><span class="text-[#16A34A]">3.</span> Need a third option?</p>
            <p class="text-[14px] text-[#6B6965] dark:text-muted-dark leading-relaxed mt-0.5">Switch the toggle to <strong class="text-ink dark:text-ink-dark">Yes / No / Maybe</strong> to add a purple <strong class="text-ink dark:text-ink-dark">M</strong> button for an equal-odds Maybe.</p>
          </div>
        </div>
        <div class="bg-white dark:bg-card-dark border border-[#E4E2DC] dark:border-border-dark rounded-2xl overflow-hidden">
          <img
            src="/images/how-to-use-history.webp"
            alt="History tracker showing recent Yes and No results with a running tally"
            width="1100"
            height="794"
            loading="lazy"
            style="width: 100%; height: auto; aspect-ratio: 1100 / 794; object-fit: cover; object-position: center; display: block;"
          />
          <div class="p-5">
            <p class="font-medium text-[15px] text-[#1A1A18] dark:text-ink-dark"><span class="text-[#16A34A]">4.</span> Track your answers</p>
            <p class="text-[14px] text-[#6B6965] dark:text-muted-dark leading-relaxed mt-0.5">Your last few results show up in the history strip with a running Yes/No tally, saved right in your browser.</p>
          </div>
        </div>
      </div>
      <div class="mt-6 bg-[#F0FDF4] dark:bg-[#0A2E1A] border-l-3 border-[#16A34A] rounded-r-lg p-[14px_16px] text-sm text-[#15803D] dark:text-[#22C55E] leading-relaxed">
        Every press is a fresh, independent 50/50 roll  -  press as many times as you want.
      </div>
    </div>
  </section>

  <!-- Section 4: How Does It Work [bg: #FFFFFF] -->
  <section id="how-it-works" class="py-[80px] max-sm:py-[48px] bg-white dark:bg-card-dark">
    <div class="container max-w-3xl">
      <span class="block text-xs font-medium tracking-[0.1em] text-[#16A34A] uppercase mb-2.5">HOW IT WORKS</span>
      <h2 class="font-display text-[36px] max-sm:text-[28px] font-bold text-[#1A1A18] dark:text-ink-dark leading-[1.15] mb-2">
        How Does the Yes No Button Work?
      </h2>

      <!-- How It Works Mini Diagram -->
      <div class="flex items-center justify-center gap-3 my-8 max-sm:flex-col max-sm:gap-2">
        <div class="border border-[#E4E2DC] dark:border-border-dark rounded-xl px-5 py-3 bg-white dark:bg-card-dark text-sm font-medium text-[#1A1A18] dark:text-ink-dark w-full max-sm:text-center">
          Button Click
        </div>
        <span class="text-[#B0AEA8] text-xl font-medium max-sm:rotate-90 max-sm:scale-x-[-1]">→</span>
        <div class="border border-[#E4E2DC] dark:border-border-dark rounded-xl px-5 py-3 bg-white dark:bg-card-dark text-sm font-medium text-center w-full">
          <span class="text-[#1A1A18] dark:text-ink-dark">Math.random()</span>
          <div class="flex items-center gap-0 mt-1.5">
            <span class="text-[10px] text-[#6B6965] dark:text-[#9B9890]">0.0</span>
            <div class="flex-1 h-2 rounded-full mx-1 overflow-hidden flex">
              <div class="h-full w-1/2 bg-[#16A34A]"></div>
              <div class="h-full w-1/2 bg-[#DC2626]"></div>
            </div>
            <span class="text-[10px] text-[#6B6965] dark:text-[#9B9890]">1.0</span>
          </div>
        </div>
        <span class="text-[#B0AEA8] text-xl font-medium max-sm:rotate-90 max-sm:scale-x-[-1]">→</span>
        <div class="border border-[#E4E2DC] dark:border-border-dark rounded-xl px-5 py-3 bg-white dark:bg-card-dark text-sm font-medium text-[#1A1A18] dark:text-ink-dark w-full max-sm:text-center">
          YES or NO
        </div>
      </div>

      <div class="text-muted dark:text-muted-dark space-y-4 leading-relaxed">
        <p>The Yes No Button uses JavaScript's <code class="font-mono text-xs px-1.5 py-0.5 rounded bg-border/30 dark:bg-border-dark/30 text-ink dark:text-ink-dark">Math.random()</code> function  -  a cryptographically seeded pseudorandom number generator built into every modern web browser. When you click the button, the tool generates a random decimal number between 0 and 1.</p>
        <p>If the number is below 0.5, the answer is No. If it is 0.5 or above, the answer is Yes. This gives an exact 50/50 probability, mathematically equivalent to flipping a fair coin. In Maybe mode (three-way), the range is split into three equal thirds: 0 to 0.333 for No, 0.333 to 0.666 for Yes, and 0.666 to 1 for Maybe.</p>
        <p>Each result is fully independent  -  previous outcomes have no influence on the next one. The tool does not store your questions or record your answers on any server. It is 100% client-side, running entirely in your browser with zero data sent over the network.</p>
      </div>

      <img
        src="/images/no-result-screenshot.webp"
        alt="Yes No Button showing a NO result in red"
        width="600"
        height="400"
        loading="lazy"
        style="border-radius: 16px; border: 1px solid #E4E2DC; width: 100%; max-width: 560px; height: auto; aspect-ratio: 600 / 400; display: block; margin: 24px auto;"
      />

      <h3 class="font-display text-lg md:text-xl tracking-tight text-ink dark:text-ink-dark mt-10 mb-6">Comparison with other methods</h3>
      <div class="overflow-x-auto" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="ynb-table">
          <thead>
            <tr>
              <th>Method</th>
              <th>Speed</th>
              <th>Bias-free?</th>
              <th>Fun factor</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="text-ink dark:text-ink-dark">Flipping a coin</td><td class="text-muted dark:text-muted-dark">Slow (need a coin)</td><td class="text-muted dark:text-muted-dark">Yes</td><td class="text-muted dark:text-muted-dark">Medium</td></tr>
            <tr><td class="text-ink dark:text-ink-dark">Asking a friend</td><td class="text-muted dark:text-muted-dark">Medium</td><td class="text-muted dark:text-muted-dark">No</td><td class="text-muted dark:text-muted-dark">High</td></tr>
            <tr><td class="text-ink dark:text-ink-dark">Magic 8-ball</td><td class="text-muted dark:text-muted-dark">Medium</td><td class="text-muted dark:text-muted-dark">Yes</td><td class="text-muted dark:text-muted-dark">High</td></tr>
            <tr class="winner-row"><td class="text-ink dark:text-ink-dark">Yes No Button</td><td class="text-muted dark:text-muted-dark">Instant</td><td class="text-muted dark:text-muted-dark">Yes</td><td class="text-muted dark:text-muted-dark">High</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 8: Category Questions [bg: #FAFAF8] -->
