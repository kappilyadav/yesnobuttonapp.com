---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import YesNoTool from '../components/tool/YesNoTool.astro';
import ResultPopup from '../components/tool/ResultPopup.astro';
import HistoryTracker from '../components/tool/HistoryTracker.astro';
import FAQAccordion from '../components/content/FAQAccordion.astro';
import MoreTools from '../components/content/MoreTools.astro';
import BlogSection from '../components/content/BlogSection.astro';
import { webAppSchema, createFaqSchema, breadcrumbSchema } from '../data/schemas';

const faqItems = [
  { category: 'general', question: 'What is a yes or no generator?', answer: 'A yes or no generator is a free online tool that randomly produces a yes or no answer with 50/50 probability. It uses JavaScript\'s Math.random() function to generate a result that is truly unbiased and unpredictable.' },
  { category: 'general', question: 'Is this yes or no generator truly random?', answer: 'Yes. The generator uses Math.random() seeded from the browser\'s system entropy. Each generated result is statistically independent: past results have zero influence on future ones. The probability is exactly 50% for Yes and 50% for No.' },
  { category: 'general', question: 'How many times can I use the yes or no generator?', answer: 'Unlimited. Generate as many yes or no results as you need. There is no daily limit, no sign-up, and no cost.' },
  { category: 'general', question: 'Can I share my generated result?', answer: 'Yes. After generating a result, click "Share Result" to copy a URL that opens the same result when visited. Share it via text, WhatsApp, or social media.' },
  { category: 'general', question: 'Is the yes or no generator free?', answer: 'Completely free. No subscription, no account, no advertisements interrupting your use. The generator will always be free.' },
];

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Yes or No Generator', url: '/yes-or-no-generator' },
]);
---

<BaseLayout
  title="Yes or No Generator — Free Random Yes No Generator Online"
  description="Free yes or no generator. Generate a truly random yes or no answer in one click. 50/50 probability, voice output, shareable results. No sign-up."
  canonical="https://yesnobuttonapp.com/yes-or-no-generator"
  schema={[webAppSchema, createFaqSchema(faqItems), breadcrumb]}
>
  <Fragment slot="header"><Header /></Fragment>

  <!-- HERO -->
  <section class="bg-canvas dark:bg-canvas-dark py-[80px] max-sm:py-[48px]">
    <div class="container text-center">
      <h1 class="font-display text-5xl md:text-6xl font-bold text-ink dark:text-ink-dark leading-tight mb-3">
        Yes or No Generator
      </h1>
      <p class="text-muted dark:text-muted-dark mb-10 leading-relaxed max-w-xl mx-auto">
        Instantly generate a random yes or no answer. Free. 50/50. No sign-up.
      </p>
      <YesNoTool />
      <ResultPopup />
      <HistoryTracker />
    </div>
  </section>

  <!-- SECTION 1: What Is a Yes or No Generator? -->
  <section class="bg-card dark:bg-card-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-4">
        What Is a Yes or No Generator?
      </h2>
      <p class="text-muted dark:text-muted-dark leading-relaxed mb-4">
        A yes or no generator is a free online tool that randomly produces either a Yes or No answer with equal probability. Unlike asking a friend - who has opinions and biases - or flipping a coin - which requires a physical coin - a yes or no generator works instantly on any device: phone, tablet, or computer. This generator uses JavaScript's Math.random() function to ensure true 50/50 probability. Every time you generate a result, it is completely independent of previous generations. The generator cannot be influenced, manipulated, or predicted. It is the purest form of random decision-making available online, and it is completely free.
      </p>
    </div>
  </section>

  <!-- SECTION 2: How to Use This Yes or No Generator -->
  <section class="bg-canvas dark:bg-canvas-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-5">
        How to Use This Yes or No Generator
      </h2>
      <ol class="list-decimal list-inside text-muted dark:text-muted-dark space-y-3 leading-relaxed">
        <li>Type your question into the generator's input field (optional but adds context).</li>
        <li>Click the "Press to Decide" button to trigger the generator.</li>
        <li>The generator instantly produces a <strong class="text-yes">YES</strong> (green) or <strong class="text-no">NO</strong> (red) result.</li>
        <li>The generator reads your result aloud using built-in voice synthesis.</li>
        <li>Click the button again to generate an independent result.</li>
      </ol>
    </div>
  </section>

  <!-- SECTION 3: Yes or No Generator vs Other Decision Methods -->
  <section class="bg-card dark:bg-card-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-5">
        Yes or No Generator vs Other Decision Methods
      </h2>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-border dark:border-border-dark">
              <th class="text-left py-2.5 px-3 font-medium text-ink dark:text-ink-dark">Method</th>
              <th class="text-left py-2.5 px-3 font-medium text-ink dark:text-ink-dark">Speed</th>
              <th class="text-left py-2.5 px-3 font-medium text-ink dark:text-ink-dark">Bias-free?</th>
              <th class="text-left py-2.5 px-3 font-medium text-ink dark:text-ink-dark">Voice</th>
              <th class="text-left py-2.5 px-3 font-medium text-ink dark:text-ink-dark">Free?</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border/50 dark:border-border-dark/50"><td class="py-2.5 px-3 text-ink dark:text-ink-dark font-medium">Yes or No Generator</td><td class="py-2.5 px-3 text-muted dark:text-muted-dark">Instant</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td></tr>
            <tr class="border-b border-border/50 dark:border-border-dark/50"><td class="py-2.5 px-3 text-ink dark:text-ink-dark">Coin flip</td><td class="py-2.5 px-3 text-muted dark:text-muted-dark">Slow</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td><td class="py-2.5 px-3 text-no">&#x2717; No</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td></tr>
            <tr class="border-b border-border/50 dark:border-border-dark/50"><td class="py-2.5 px-3 text-ink dark:text-ink-dark">Asking a friend</td><td class="py-2.5 px-3 text-muted dark:text-muted-dark">Slow</td><td class="py-2.5 px-3 text-no">&#x2717; No</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td></tr>
            <tr class="border-b border-border/50 dark:border-border-dark/50"><td class="py-2.5 px-3 text-ink dark:text-ink-dark">Magic 8-ball</td><td class="py-2.5 px-3 text-muted dark:text-muted-dark">Medium</td><td class="py-2.5 px-3 text-yes">&#x2713; Yes</td><td class="py-2.5 px-3 text-no">&#x2717; No</td><td class="py-2.5 px-3 text-no">&#x2717; No</td></tr>
            <tr class="border-b border-border/50 dark:border-border-dark/50"><td class="py-2.5 px-3 text-ink dark:text-ink-dark">Decision matrix</td><td class="py-2.5 px-3 text-muted dark:text-muted-dark">Very slow</td><td class="py-2.5 px-3 text-no">&#x2717; No</td><td class="py-2.5 px-3 text-no">&#x2717; No</td><td class="py-2.5 px-3 text-muted">Varies</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-muted dark:text-muted-dark leading-relaxed">
        The yes or no generator wins on speed and accessibility. Unlike all other methods, this generator is available 24/7 on any device with zero setup.
      </p>
    </div>
  </section>

  <!-- SECTION 4: Yes No Maybe Generator -->
  <section class="bg-canvas dark:bg-canvas-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-4">
        Yes No Maybe Generator
      </h2>
      <p class="text-muted dark:text-muted-dark leading-relaxed mb-4">
        Need more than two options? Switch to Yes No Maybe Generator mode by clicking the toggle above the button. In this mode, the generator produces one of three results - Yes, No, or Maybe - each with exactly 33.3% probability. The Maybe result is useful for decisions where a binary answer would be dishonest or where you genuinely need to sit with the ambiguity a little longer.
      </p>

    </div>
  </section>

  <!-- SECTION 5: Why Use a Yes or No Generator? -->
  <section class="bg-card dark:bg-card-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-5">
        Why Use a Yes or No Generator?
      </h2>
      <div class="text-muted dark:text-muted-dark space-y-4 leading-relaxed">
        <p><strong class="text-ink dark:text-ink-dark">Unbiased:</strong> The generator has no opinion: pure mathematics. Every result is determined by JavaScript's Math.random() with zero human influence.</p>
        <p><strong class="text-ink dark:text-ink-dark">Instant:</strong> The generator produces a result in under 200 milliseconds. No waiting, no setup, no friction.</p>
        <p><strong class="text-ink dark:text-ink-dark">Unlimited:</strong> Generate as many results as you need. The generator never runs out, never tires, and never charges.</p>
        <p><strong class="text-ink dark:text-ink-dark">Private:</strong> Your questions are never sent to any server: 100% client-side processing. The generator runs entirely in your browser.</p>
        <p><strong class="text-ink dark:text-ink-dark">Voice:</strong> The generator speaks the result aloud using the Web Speech API. Hear your answer without looking at the screen.</p>
        <p><strong class="text-ink dark:text-ink-dark">Shareable:</strong> Copy a link to your generated result and share it anywhere. The generator preserves your outcome for sharing on social media or messaging apps.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-canvas dark:bg-canvas-dark py-[80px] max-sm:py-[48px]">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink dark:text-ink-dark mb-6">
        Frequently Asked Questions
      </h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <BlogSection />

  <MoreTools />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<script>
  import { initTool } from '../scripts/tool';
  initTool();
</script>
