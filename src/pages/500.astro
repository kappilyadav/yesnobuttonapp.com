---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createWebPageSchema } from '../data/schemas';
---

<BaseLayout
  title="500  -  Server Error | Yes No Button"
  description="Something went wrong on our end. Please try again or return to the Yes No Button homepage."
  canonical="https://yesnobuttonapp.com/500"
  schema={[createWebPageSchema("Something went wrong on our end. Please try again or return to the Yes No Button homepage.", 'https://yesnobuttonapp.com/500')]}
>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="font-display text-6xl md:text-8xl tracking-tight text-ink dark:text-ink-dark mb-4">500</h1>
    <p class="text-muted dark:text-muted-dark text-lg mb-8">The button glitched. Try pressing it again.</p>
    <a href="/" class="inline-flex items-center px-6 py-3 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark font-display text-base hover:scale-102 active:scale-98 transition-transform no-underline">
      Press to Go Home
    </a>
  </div>
</BaseLayout>
