---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MoreTools from '../components/content/MoreTools.astro';
import { breadcrumbSchema, createWebPageSchema } from '../data/schemas';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Terms & Conditions', url: '/terms/' },
]);

const lastUpdated = 'October 18, 2026';
---

<BaseLayout
  title="Terms &amp; Conditions | Yes No Button"
  description="Terms and conditions for using the Yes No Button website and tool. Free to use, no guarantees, use at your own risk."
  canonical="https://yesnobuttonapp.com/terms/"
  schema={[createWebPageSchema("Terms and conditions for using the Yes No Button website and tool. Free to use, no guarantees, use at your own risk.", 'https://yesnobuttonapp.com/terms/', 'Terms & Conditions'), breadcrumb]}
>
  <Fragment slot="header"><Header /></Fragment>

  <section class="py-[80px] max-sm:py-[48px] bg-[#FAFAF8] dark:bg-canvas-dark">
    <div class="container max-w-3xl">
      <div class="flex flex-wrap gap-2 mb-6">
        <a href="/about/" class="text-xs px-3 py-1.5 rounded-full bg-white dark:bg-card-dark border border-border dark:border-border-dark text-muted dark:text-muted-dark hover:text-ink dark:hover:text-ink-dark transition-colors no-underline">About</a>
        <a href="/privacy-policy/" class="text-xs px-3 py-1.5 rounded-full bg-white dark:bg-card-dark border border-border dark:border-border-dark text-muted dark:text-muted-dark hover:text-ink dark:hover:text-ink-dark transition-colors no-underline">Privacy</a>
        <a href="/terms/" class="text-xs px-3 py-1.5 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark border border-btn-bg dark:border-btn-bg-dark no-underline">Terms</a>
        <a href="/disclaimer/" class="text-xs px-3 py-1.5 rounded-full bg-white dark:bg-card-dark border border-border dark:border-border-dark text-muted dark:text-muted-dark hover:text-ink dark:hover:text-ink-dark transition-colors no-underline">Disclaimer</a>
        <a href="/contact/" class="text-xs px-3 py-1.5 rounded-full bg-white dark:bg-card-dark border border-border dark:border-border-dark text-muted dark:text-muted-dark hover:text-ink dark:hover:text-ink-dark transition-colors no-underline">Contact</a>
      </div>
      <span class="block text-xs font-medium tracking-[0.1em] text-[#16A34A] uppercase mb-2.5">TERMS &amp; CONDITIONS</span>
      <h1 class="font-display text-[36px] max-sm:text-[28px] font-bold text-ink dark:text-ink-dark leading-[1.15] mb-2">Terms &amp; Conditions</h1>
      <p class="text-muted dark:text-muted-dark text-sm mb-8">Last updated: {lastUpdated}</p>

      <div class="text-muted dark:text-muted-dark space-y-6 leading-relaxed">
        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Acceptance of Terms</h2>
          <p>By accessing or using the Yes No Button website ("the Service"), you agree to be bound by these Terms &amp; Conditions. If you do not agree with any part of these terms, you may not use the Service.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Use of the Service</h2>
          <p>The Yes No Button is a free online tool provided for entertainment, decision-making assistance, and educational purposes. You agree to use the Service only for lawful purposes and in accordance with these terms.</p>
          <ul class="list-disc list-inside space-y-1 mt-2">
            <li>You may use the tool for personal, educational, or commercial purposes</li>
            <li>You may embed the tool on your website using the provided embed code</li>
            <li>You may not attempt to reverse-engineer, abuse, or disrupt the Service</li>
            <li>You may not use the Service for any illegal activity</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">No Guarantees</h2>
          <p>The Yes No Button is provided "as is" and "as available" without any warranty of any kind, either express or implied. We do not guarantee that:</p>
          <ul class="list-disc list-inside space-y-1 mt-2">
            <li>The tool will be available at all times without interruption</li>
            <li>The random results will suit your specific needs or preferences</li>
            <li>The decisions you make based on the tool's output will lead to favorable outcomes</li>
          </ul>
          <p class="mt-3">The random answers generated by the tool are for entertainment and decision-making support only. They should not be relied upon for serious medical, legal, financial, or safety-related decisions. Always use your own judgment for important matters.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Intellectual Property</h2>
          <p>The Yes No Button name, logo, and website design are our intellectual property. The tool itself is provided free of charge and may be embedded on other websites using the provided embed code.</p>
          <p>You may not reproduce, distribute, or create derivative works of the Service or its components without prior written consent, except as expressly permitted (such as embedding the tool).</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Embedding the Widget</h2>
          <p>You may embed the Yes No Button on your own website using the iframe code on our <a href="/embed-yes-no-button/" class="text-ink dark:text-ink-dark underline hover:no-underline">embed page</a>. Embedding is free, including for commercial sites. In return, please:</p>
          <ul class="list-disc list-inside space-y-1 mt-2">
            <li>Use the code as provided, without hiding, covering or altering the widget in a misleading way</li>
            <li>Not present the widget as your own product or imply that we endorse your site</li>
            <li>Not embed it on sites that are unlawful, hateful or deceptive</li>
          </ul>
          <p class="mt-3">We may change or remove the embed at any time, and we may block sites that abuse it.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Advertising and Third-Party Services</h2>
          <p>The Service is supported by advertising and uses third-party services such as Google AdSense, Google Analytics and Cloudflare. Your use of those services through our site is also subject to their own terms and policies. How we handle cookies and data is explained in our <a href="/privacy-policy/" class="text-ink dark:text-ink-dark underline hover:no-underline">Privacy Policy</a>.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Installing and Offline Use</h2>
          <p>You may bookmark the Service or add it to your device's home screen. When you do, your browser may keep copies of our pages and files so they open faster or work offline. Offline copies may be out of date until your device reconnects, and results generated offline are for the same entertainment and decision-support purposes described in these terms.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Availability and Changes to the Service</h2>
          <p>We may change, suspend or discontinue any part of the Service, including individual tools such as the Yes No Wheel or Yes No Oracle, at any time and without notice. We may also block access for people or sites that abuse the Service or place unreasonable load on it.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Limitation of Liability</h2>
          <p>To the fullest extent permitted by law, YesNoButton shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising out of or related to your use of the Service. This includes, but is not limited to, damages for loss of profits, goodwill, use, data, or other intangible losses.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">External Links</h2>
          <p>The Service may contain links to third-party websites or services. We are not responsible for the content, privacy policies, or practices of any third-party websites.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Changes to Terms</h2>
          <p>We reserve the right to modify or replace these terms at any time. Changes will be posted on this page with an updated "Last updated" date. Continued use of the Service after changes constitutes acceptance of the new terms.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Severability</h2>
          <p>If any part of these terms is found to be unenforceable, the remaining parts stay in effect.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Governing Law</h2>
          <p>These terms shall be governed by and construed in accordance with the laws of the jurisdiction in which the Service operates, without regard to its conflict of law provisions.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-ink dark:text-ink-dark mb-3">Contact</h2>
          <p>If you have any questions about these Terms &amp; Conditions, please <a href="/contact/" class="text-ink dark:text-ink-dark underline hover:no-underline">contact us</a> or email <a href="mailto:hello@yesnobuttonapp.com" class="text-ink dark:text-ink-dark underline hover:no-underline">hello@yesnobuttonapp.com</a>.</p>
        </section>
      </div>
    </div>
  </section>

  <MoreTools />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
