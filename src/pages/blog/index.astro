---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import MoreTools from '../../components/content/MoreTools.astro';
import { collectionPageSchema, breadcrumbSchema } from '../../data/schemas';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
]);
---

<BaseLayout
  title="Yes No Button Blog  -  Decision Making Tips & Questions"
  description="Read the Yes No Button blog for decision-making tips, question ideas, and guides to using the random decision maker effectively."
  canonical="https://yesnobuttonapp.com/blog/"
  schema={[collectionPageSchema, breadcrumb]}
>
  <Fragment slot="header"><Header /></Fragment>

  <section class="py-12 md:py-20">
    <div class="container max-w-3xl">
      <h1 class="font-display text-3xl md:text-5xl tracking-tight text-ink dark:text-ink-dark mb-3">
        Blog
      </h1>
      <p class="text-muted dark:text-muted-dark text-lg mb-10">
        Decision-making tips, question ideas, and guides.
      </p>

      <div class="space-y-8">
        {posts.map((post) => (
          <article class="border-b border-border dark:border-border-dark pb-8">
            <time class="text-xs text-muted dark:text-muted-dark">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2 class="font-display text-xl md:text-2xl tracking-tight mt-1 mb-2">
              <a href={`/blog/${post.id}/`} class="text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">
                {post.data.title}
              </a>
            </h2>
            <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">
              {post.data.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <MoreTools />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
