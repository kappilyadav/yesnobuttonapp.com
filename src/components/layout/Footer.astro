---
// components/layout/Footer.astro
---

<footer class="bg-[#FAF5E8] dark:bg-[#1C1C1A] border-t border-border dark:border-border-dark">
  <div class="container py-12 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-8">
      <div>
        <h3 class="font-display text-sm uppercase tracking-wider text-muted dark:text-muted-dark mb-4">Tool</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Yes No Button</a></li>
          <li><a href="/yes-no-oracle" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Yes No Oracle</a></li>
          <li><a href="/yes-no-wheel" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Yes No Wheel</a></li>
          <li><a href="/yes-or-no" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Yes or No</a></li>
          <li><a href="/yes-or-no-generator" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Yes or No Generator</a></li>
          <li><a href="/random-yes-or-no" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Random Yes or No</a></li>
          <li><a href="/bluey-yes-no-button" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Bluey Yes No Button</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-display text-sm uppercase tracking-wider text-muted dark:text-muted-dark mb-4">Use Cases</h3>
        <ul class="space-y-2">
          <li><a href="/yes-no-button-for-teachers" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">For Teachers</a></li>
          <li><a href="/" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Decision Making</a></li>
          <li><a href="/yes-no-button-for-teachers" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Classroom Icebreakers</a></li>
          <li><a href="/yes-no-wheel" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Games &amp; Spinners</a></li>
          <li><a href="/bluey-yes-no-button" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Kids Activities</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-display text-sm uppercase tracking-wider text-muted dark:text-muted-dark mb-4">Company</h3>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">About Us</a></li>
          <li><a href="/contact" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Contact Us</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-display text-sm uppercase tracking-wider text-muted dark:text-muted-dark mb-4">Resources</h3>
        <ul class="space-y-2">
          <li><a href="/embed" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Embed Widget</a></li>
          <li><a href="/blog" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Blog</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-display text-sm uppercase tracking-wider text-muted dark:text-muted-dark mb-4">Legal</h3>
        <ul class="space-y-2">
          <li><a href="/privacy-policy" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-ink dark:text-ink-dark hover:text-muted dark:hover:text-muted-dark transition-colors no-underline">Terms &amp; Conditions</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-border dark:border-border-dark pt-6 text-center">
      <p class="text-sm text-muted dark:text-muted-dark">
        &copy; {new Date().getFullYear()} YesNoButton. All rights reserved.
      </p>
      <p class="text-xs text-muted dark:text-muted-dark mt-2">
        The Yes No Button is a free, random online decision maker. No sign-up required.
      </p>
    </div>
  </div>
</footer>
