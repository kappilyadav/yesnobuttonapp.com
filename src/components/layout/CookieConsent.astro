---
// components/layout/CookieConsent.astro
import { getLocale, getUi } from '../../i18n/utils';

const t = getUi(getLocale(Astro));
---

<div id="cookie-consent" role="dialog" aria-label={t.cookieAria} class="fixed inset-x-0 bottom-0 z-[60] p-4">
  <div class="mx-auto max-w-3xl flex flex-col sm:flex-row sm:items-center gap-4 p-4 md:p-5 rounded-2xl border border-border dark:border-border-dark bg-card dark:bg-card-dark shadow-lg">
    <p class="flex-1 text-sm text-muted dark:text-muted-dark leading-relaxed m-0">
      <Fragment set:html={t.cookieText} />
    </p>
    <div class="flex gap-2 shrink-0">
      <button type="button" data-consent="denied" class="px-4 py-2 rounded-full border border-border dark:border-border-dark text-sm text-ink dark:text-ink-dark cursor-pointer bg-transparent hover:bg-black/5 dark:hover:bg-white/5">{t.reject}</button>
      <button type="button" data-consent="granted" class="px-4 py-2 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm cursor-pointer border-0">{t.accept}</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'ynb_consent';
    var box = document.getElementById('cookie-consent');
    if (!box) return;
    function read() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }
    function choose(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      if (typeof gtag === 'function') {
        gtag('consent', 'update', {
          ad_storage: value,
          ad_user_data: value,
          ad_personalization: value,
          analytics_storage: value
        });
      }
      box.classList.add('hidden');
      box.classList.remove('force-open');
    }
    // The banner is visible in the HTML (so it paints with the page); the head script
    // hides it before first paint when a choice is already saved.
    if (read() === 'granted' || read() === 'denied') box.classList.add('hidden');
    box.querySelectorAll('[data-consent]').forEach(function (b) {
      b.addEventListener('click', function () { choose(b.getAttribute('data-consent')); });
    });
    document.querySelectorAll('[data-cookie-settings]').forEach(function (b) {
      b.addEventListener('click', function () { box.classList.remove('hidden'); box.classList.add('force-open'); });
    });
  })();
</script>
