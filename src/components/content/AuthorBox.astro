---
interface Props {
  pubDate: Date;
  updatedDate?: Date;
}

const { pubDate, updatedDate } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<div class="flex flex-col gap-4 mb-8 p-5 md:p-6 rounded-2xl border border-border dark:border-border-dark bg-card dark:bg-card-dark border-l-4 border-l-ink dark:border-l-ink-dark">
  <div class="flex items-center gap-4">
    <a href="/author/" class="shrink-0" aria-label="About Kapil Yadav">
      <img
        src="/images/kappil-yadav.webp"
        alt="Kapil Yadav"
        width="64"
        height="64"
        class="w-14 h-14 md:w-16 md:h-16 rounded-full border-2 border-border dark:border-border-dark object-cover"
      />
    </a>
    <div class="min-w-0">
      <p class="text-base md:text-lg text-muted dark:text-muted-dark m-0">
        Written by <a href="/author/" class="font-semibold text-ink dark:text-ink-dark no-underline hover:underline">Kapil Yadav</a>
      </p>
      <p class="text-sm text-muted dark:text-muted-dark m-0 mt-1">Full-Stack Developer, YesNoButtonApp</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2 text-xs md:text-sm text-muted dark:text-muted-dark">
    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-border dark:border-border-dark">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      Published <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
    </span>
    {updatedDate && (
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-border dark:border-border-dark">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
        Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time>
      </span>
    )}
  </div>
</div>
