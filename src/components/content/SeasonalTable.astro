---
// components/content/SeasonalTable.astro
export interface SeasonalQuestion {
  question: string;
  reason: string;
}

export interface Props {
  month: string;
  year: number;
  questions: SeasonalQuestion[];
}

const { month, year, questions } = Astro.props;
---

<>
  <h2 class="font-display text-2xl md:text-3xl tracking-tight text-ink dark:text-ink-dark mb-4">
    {month} {year} Yes or No Questions
  </h2>
  <p class="text-muted dark:text-muted-dark mb-6 max-w-2xl">
    Seasonal questions to ask the Yes No Button this {month.toLowerCase()}. These questions are themed around the time of year to help you make timely decisions.
  </p>
  <div class="overflow-x-auto" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table class="ynb-table">
      <thead>
        <tr>
          <th>Question</th>
          <th>Why ask it?</th>
        </tr>
      </thead>
      <tbody>
        {
          questions.map((q) => (
            <tr>
              <td class="text-ink dark:text-ink-dark">{q.question}</td>
              <td class="text-muted dark:text-muted-dark">{q.reason}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</>
