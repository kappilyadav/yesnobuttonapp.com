---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestPosts = posts.slice(0, 3);
---

{
  latestPosts.length > 0 && (
    <section class="py-[80px] max-sm:py-[48px] bg-canvas dark:bg-canvas-dark">
      <div class="container max-w-6xl">
        <div class="mb-10">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-ink dark:text-ink-dark leading-tight">
            Latest from the Blog
          </h2>
          <p class="text-muted dark:text-muted-dark mt-2">
            Decision-making tips, question ideas, and guides.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => {
            const heroBase = `/images/${post.id}-hero`;
            const hero1200 = `${heroBase}-1200.webp`;
            const hero800 = `${heroBase}-800.webp`;
            const hero400 = `${heroBase}-400.webp`;
            const fallback = '/images/og-image.webp';
            return (
              <article class="group block bg-card dark:bg-card-dark rounded-xl overflow-hidden border border-border dark:border-border-dark transition-shadow hover:shadow-lg">
                <a href={`/blog/${post.id}/`} class="no-underline text-inherit block">
                  <picture>
                    <source type="image/webp" srcset={`${hero1200} 1200w, ${hero800} 800w, ${hero400} 400w`} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px" />
                    <img src={hero1200} alt={`Illustration for ${post.data.title}`} loading="lazy" class="w-full h-44 object-cover sm:h-48 md:h-40 lg:h-44" onerror={`this.src='${fallback}'`} />
                  </picture>
                  <div class="p-4">
                    <time class="text-xs text-muted dark:text-muted-dark block">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                    <h3 class="font-display text-lg mt-2 mb-2 text-ink dark:text-ink-dark leading-tight">{post.data.title}</h3>
                    <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">{post.data.description}</p>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        <div class="text-center mt-10">
          <a href="/blog/" class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium hover:bg-[#27272A] dark:hover:bg-[#D4D2CC] transition-colors no-underline cursor-pointer">
            View all posts
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg>
          </a>
        </div>
      </div>
    </section>
  )
}
