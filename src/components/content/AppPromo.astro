---
// Optional "get the Android app" prompt. Static, fixed-size and below the
// fold of the tool so it never competes with the browser experience or ads.
import { playUrl, type AppPlacement } from '../../data/app';

interface Props {
  placement: Extract<AppPlacement, 'home' | 'blog'>;
  heading?: string;
  text?: string;
}

const {
  placement,
  heading = 'Prefer an app?',
  text = 'The Yes No Button is also free on Android. The website stays exactly as it is.',
} = Astro.props;
---

<aside class="app-promo my-0" aria-label="Android app">
  <div class="container max-w-3xl">
    <div class="flex items-center justify-between gap-4 max-sm:flex-col max-sm:items-start rounded-2xl border border-border dark:border-border-dark bg-card dark:bg-card-dark px-5 py-4">
      <div class="flex items-center gap-3 min-w-0">
        <img src="/icon-any-192.png" alt="" width="44" height="44" class="rounded-xl shrink-0" loading="lazy" />
        <div class="min-w-0">
          <p class="m-0 text-sm font-semibold text-ink dark:text-ink-dark">{heading}</p>
          <p class="m-0 text-sm text-muted dark:text-muted-dark">{text}</p>
        </div>
      </div>
      <a
        href={playUrl(placement)}
        target="_blank"
        rel="noopener"
        class="shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-btn-bg dark:bg-btn-bg-dark text-btn-text dark:text-btn-text-dark text-sm font-medium no-underline hover:opacity-90 transition-opacity"
      >
        <svg width="16" height="18" viewBox="13 9 32 36" aria-hidden="true"><path d="m27.622 25.899-14.194 15.066c5.34e-4 0.0031 0.0016 0.0057 0.0021 0.0089 0.43532 1.636 1.9296 2.8406 3.703 2.8406 0.70892 0 1.3745-0.19166 1.9453-0.52812l0.04533-0.02656 15.978-9.22-7.479-8.141" fill="#eb3131"/><path d="m41.983 23.334-0.0136-0.0093-6.8982-3.999-7.7717 6.9156 7.7987 7.7977 6.8618-3.9592c1.203-0.64945 2.0197-1.9177 2.0197-3.3802 0-1.452-0.80571-2.7139-1.9968-3.3655" fill="#f6b60b"/><path d="m13.426 12.37c-0.08533 0.31466-0.13018 0.64425-0.13018 0.98651v26.623c0 0.34162 0.04432 0.67233 0.13072 0.98587l14.684-14.681-14.684-13.914" fill="#5778c5"/><path d="m27.727 26.668 7.3473-7.3451-15.96-9.2534c-0.58012-0.34746-1.2572-0.54799-1.9817-0.54799-1.7734 0-3.2697 1.2068-3.7051 2.8447-5.34e-4 0.0016-5.34e-4 0.0027-5.34e-4 0.0041l14.3 14.298" fill="#3bad49"/></svg>
        Get it on Google Play
      </a>
    </div>
  </div>
</aside>
