---
const iframeCode = `<iframe src="https://yesnobuttonapp.com/embed/" width="100%" height="480" frameborder="0" style="border-radius:12px"></iframe>`;
---

<div class="w-full max-w-xl mx-auto space-y-6">
  <div class="border border-[#333330] rounded-2xl overflow-hidden bg-[#111110] p-6">
    <iframe src="/embed/" width="100%" height="480" frameborder="0" style="border-radius:8px" title="Yes No Button embed preview"></iframe>
  </div>

  <div class="relative">
    <pre class="bg-[#0A0A09] text-[#7EC8A4] text-xs md:text-sm p-5 rounded-xl overflow-x-auto font-mono leading-relaxed border border-[#333330]"><code>{iframeCode}</code></pre>
    <button
      id="copy-embed-btn"
      class="absolute top-3 right-3 px-5 py-2 rounded-lg bg-[#16A34A] text-white text-sm font-medium hover:bg-[#15803D] transition-colors cursor-pointer"
    >
      Copy Code
    </button>
  </div>
</div>

<script>
  import { copyEmbedCode } from '../../scripts/embed';

  document.getElementById('copy-embed-btn')?.addEventListener('click', async () => {
    const code = `<iframe src="https://yesnobuttonapp.com/embed/" width="100%" height="480" frameborder="0" style="border-radius:12px"></iframe>`;
    const ok = await copyEmbedCode(code);
    const btn = document.getElementById('copy-embed-btn');
    if (btn) {
      btn.textContent = ok ? '✓ Copied!' : 'Failed';
      setTimeout(() => { btn.textContent = 'Copy Code'; }, 2000);
    }
  });
</script>
