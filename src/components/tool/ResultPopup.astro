---
// ResultPopup.astro

export interface Props {
  theme?: string;
  resultAnimation?: string;
}

const { theme, resultAnimation = 'animate-bounce-word' } = Astro.props;
---

<div
  id="result-popup"
  class="fixed inset-0 z-[9999] items-center justify-center hidden"
  style="backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); background: rgba(0,0,0,0.3)"
  role="dialog"
  aria-modal="true"
  aria-labelledby="popup-answer"
  data-result=""
  data-theme={theme === 'oracle' ? 'oracle' : undefined}
>
  <div
    id="popup-card"
    class="relative w-[500px] max-sm:w-[calc(100%-32px)] rounded-[24px] p-12 max-sm:p-8 text-center animate-popup-entry mx-6"
  >
    <!-- Question text -->
    <p id="popup-question" class="text-white text-base font-normal leading-snug opacity-85 max-w-xs mx-auto mb-6 hidden" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"></p>

    <!-- Result word -->
    <p
      id="popup-answer"
      class={`font-display text-[96px] max-sm:text-7xl text-white font-bold leading-none mb-4 ${resultAnimation}`}
    ></p>

    <!-- Subtext -->
    <p class="text-white/80 text-sm mb-8">Click anywhere to try again</p>

    <!-- Buttons -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-3">
      <button
        id="press-again-btn"
        class="px-6 py-2.5 rounded-full border-2 border-white/80 text-white text-sm font-medium hover:bg-white/10 transition-colors cursor-pointer focus:outline-hidden"
      >
        Try Again
      </button>
      <a href="https://ko-fi.com/S2R1217QU6" target="_blank" class="inline-flex items-center">
        <img height="46" style="border:0px;height:46px;" src="https://storage.ko-fi.com/cdn/kofi6.png?v=6" alt="Buy Me a Coffee at ko-fi.com" />
      </a>
    </div>

    <!-- Auto-dismiss progress bar -->
    <div class="absolute -bottom-4 left-0 right-0 h-2 rounded-[24px] overflow-hidden">
      <div id="popup-progress" class="h-full bg-white/70 animate-progress-bar rounded-[24px]"></div>
    </div>
  </div>
</div>

<style>
  #result-popup[data-result="yes"] #popup-card { background: #16A34A; }

  #result-popup[data-result="no"] #popup-card { background: #DC2626; }

  #result-popup[data-result="maybe"] #popup-card { background: #8B5CF6; }

  #result-popup[data-theme="oracle"][data-result="yes"] #popup-card { background: #D97706; }

</style>
