---
// WheelSpinner.astro — large interactive wheel
---

<div id="wheel-container" class="relative w-full max-w-[440px] aspect-square mx-auto" aria-hidden="true">
  <svg viewBox="0 0 400 400" class="w-full h-full" id="wheel-svg">
    <!-- Outer ring -->
    <circle cx="200" cy="200" r="194" fill="none" class="stroke-border dark:stroke-border-dark" stroke-width="6" />

    <!-- Inner ring glow -->
    <circle cx="200" cy="200" r="190" fill="none" stroke="rgba(139,92,246,0.08)" stroke-width="2" />

    <!-- Rotating group -->
    <g id="wheel-rotator" style="transform-origin: 200px 200px;">
      <g id="wheel-segments" />
      <g id="wheel-labels" />
    </g>

    <!-- Pointer at top -->
    <polygon points="200,34 180,10 220,10" fill="currentColor" class="text-ink dark:text-ink-dark" />

    <!-- Center spin button (outside rotating group) -->
    <g id="spin-btn">
      <circle cx="200" cy="200" r="48" fill="rgba(0,0,0,0.12)" />
      <circle cx="200" cy="200" r="46" fill="#8B5CF6" class="spin-btn-bg" />
      <polygon points="189,180 189,220 219,200" fill="#FFFFFF" />
      <circle cx="200" cy="200" r="41" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="2" />
    </g>

  </svg>
</div>

<style>
  #wheel-container {
    filter: drop-shadow(0 6px 20px rgba(0,0,0,0.1));
  }
  .dark #wheel-container {
    filter: drop-shadow(0 6px 24px rgba(0,0,0,0.4));
  }

  #spin-btn {
    transition: transform 0.15s ease;
  }
  #spin-btn:hover {
    fill: #7C3AED;
  }
  #spin-btn:hover .spin-btn-bg {
    fill: #7C3AED;
  }

  @media (prefers-reduced-motion: reduce) {
    #wheel-rotator {
      transition: none !important;
    }
    #spin-btn {
      transition: none !important;
    }
  }
</style>
