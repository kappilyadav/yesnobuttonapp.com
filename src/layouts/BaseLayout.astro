---
import '@fontsource/syne/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import { organizationSchema, websiteSchema } from '../data/schemas';
import syneWoff2 from '@fontsource/syne/files/syne-latin-700-normal.woff2?url';
import interWoff2 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  schema?: object[];
}

  const { title, description, canonical, ogImage = '/og-image.webp', schema = [] } = Astro.props;
  const allSchema = [organizationSchema, websiteSchema, ...schema];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://yesnobuttonapp.com${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://yesnobuttonapp.com${ogImage}`} />

    {allSchema.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <script is:inline>
      const t = localStorage.getItem('theme');
      const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
      if (t === 'dark' || (t !== 'light' && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>

    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preload" href={syneWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FHP1RF82CG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FHP1RF82CG');
    </script>
    <style>
      .floatingchat-container-wrap,
      .floatingchat-container-wrap-mobi {
        max-width: none !important;
      }
      .floatingchat-container,
      .floatingchat-container-mobi {
        width: 340px !important;
      }
    </style>
  </head>
  <body class="min-h-dvh flex flex-col">
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
    <script is:inline src="https://storage.ko-fi.com/cdn/scripts/overlay-widget.js"></script>
    <script is:inline>
      kofiWidgetOverlay.draw('kappilyadav', {
        'type': 'floating-chat',
        'floating-chat.donateButton.text': 'This is free. Coffee isn\'t',
        'floating-chat.donateButton.background-color': '#f45d22',
        'floating-chat.donateButton.text-color': '#fff',
        'floating-chat.stylesheets': JSON.stringify([
          'https://fonts.googleapis.com/css?family=DM+Sans:400,600,700,800&display=swap',
          window.location.origin + '/ko-fi-overrides.css'
        ])
      });
    </script>
  </body>
</html>
